# Copiar a .env (en el servidor) y completar. El .env no se sube a git.

# Dominio publico, sin https:// (ej: atenea.duckdns.org)
DOMINIO=

# Contraseña de root de MySQL. Solo se aplica la primera vez que se crea la base.
DB_PASSWORD=

# Clave para firmar los JWT, minimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
